prmtop           system.parm7
coordinates      frame.rst7
qmindices        region.qm
basis            def2-svp
method           b3lyp
charge           -4
spinmult         1
precision        dynamic
dftgrid          2
dynamicgrid      yes
sphericalbasis   yes
threall          1e-12
convthre         1e-06
maxit            500
run              energy
end
